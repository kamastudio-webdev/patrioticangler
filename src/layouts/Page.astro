---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  lede?: string;
}

const { title, description, lede } = Astro.props;
---

<Base title={title} description={description}>
  <div class="wrap page">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2rem, 6vw, 3.5rem);
    max-width: calc(46rem + 2 * var(--gutter));
  }

  .lede {
    font-size: 1.28rem;
    line-height: 1.5;
    max-width: 56ch;
    margin-top: 1rem;
  }

  .prose {
    max-width: var(--measure);
    margin-top: 1.6rem;
  }

  .prose :global(h2) {
    margin: 2.2rem 0 0.8rem;
  }

  .prose :global(ul) {
    padding-left: 1.4rem;
  }

  .prose :global(li) {
    margin-bottom: 0.45em;
  }
</style>
