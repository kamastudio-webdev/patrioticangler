---
import Bobber from './Bobber.astro';
import { SITE } from '../config';

const path = Astro.url.pathname;
const links = [
  { href: '/how-to/', label: 'How-to' },
  { href: '/gear/', label: 'Gear' },
  { href: '/made-in-usa/', label: 'Made in USA' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <Bobber size={34} class="brand-mark" line="#ffffff" band="#14304a" />
      <span class="brand-name">Patriotic Angler</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--navy);
    color: #fff;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    color: var(--navy-deep);
    flex: none;
  }

  .brand-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.85rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.4rem;
  }

  nav a {
    color: #e6edf3;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.3rem 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: #fff;
    border-bottom-color: var(--red);
  }

  @media (max-width: 560px) {
    .brand-name {
      font-size: 1.6rem;
    }
    nav ul {
      gap: 0.25rem 1.1rem;
    }
  }
</style>
