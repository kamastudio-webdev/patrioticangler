---
import { CATEGORIES } from '../config';
import { readMinutes, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <div class="meta">
            {showCategory && (
              <a class={`tag tag-${post.data.category}`} href={CATEGORIES[post.data.category].path}>
                {CATEGORIES[post.data.category].label}
              </a>
            )}
            <span class="mins">{readMinutes(post)} min read</span>
          </div>
          <h3>
            <a href={`/${post.id}/`}>{post.data.title}</a>
          </h3>
          <p>{post.data.description}</p>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--navy);
  }

  li {
    border-bottom: 1px solid var(--rule);
    padding: 1.4rem 0 1.2rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.55rem;
  }

  .mins {
    font-size: 0.88rem;
    color: var(--muted);
  }

  h3 {
    font-size: clamp(1.55rem, 3vw, 1.9rem);
    margin-bottom: 0.4rem;
  }

  h3 a {
    color: var(--navy);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--red-dark);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  p {
    margin: 0;
    color: var(--muted);
    max-width: 64ch;
  }
</style>
