---
import Base from '../layouts/Base.astro';
import Contours from '../components/Contours.astro';
import PostList from '../components/PostList.astro';
import MadeBadge from '../components/MadeBadge.astro';
import TackleTray from '../components/TackleTray.astro';
import { SITE } from '../config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = [...posts.filter((p) => p.data.featured), ...posts.filter((p) => !p.data.featured)].slice(0, 8);
const byId = Object.fromEntries(posts.map((p) => [p.id, p]));

const path = [
  {
    id: 'beginner-fishing-starter-kit',
    step: 'Get the gear',
    line: 'One rod, a spool of line, a few hooks and bobbers. Here is the whole list.',
  },
  {
    id: 'palomar-knot-and-improved-clinch-knot',
    step: 'Tie one good knot',
    line: 'Most lost fish are lost at the knot. Learn the Palomar and you are set.',
  },
  {
    id: 'how-to-catch-bluegill-with-kids',
    step: 'Catch your first fish',
    line: 'Bluegill bite all summer, close to shore. A worm and a bobber is all it takes.',
  },
].filter((s) => byId[s.id]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<Base title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <Contours />
    <div class="wrap hero-inner">
      <h1>Plain answers for your next day on the water.</h1>
      <p class="sub">
        Step-by-step fishing how-tos, gear that's worth the money, and a brass stamp on everything made in
        the USA.
      </p>
      <div class="actions">
        <a class="btn btn-red" href="/beginner-fishing-starter-kit/">Start with the beginner kit</a>
        <a class="btn btn-ghost" href="/american-made-fishing-gear-guide/">See American-made gear</a>
      </div>
    </div>
  </section>

  <section class="wrap types" aria-labelledby="types-h">
    <h2 id="types-h">What are you fishing for?</h2>
    <TackleTray />
  </section>

  {
    path.length === 3 && (
      <section class="wrap first-trip" aria-labelledby="first-trip-h">
        <h2 id="first-trip-h">New to fishing? Your first trip in three steps</h2>
        <ol class="steps">
          {path.map((s) => (
            <li>
              <p class="step-name">{s.step}</p>
              <p class="step-line">{s.line}</p>
              <a href={`/${s.id}/`}>{byId[s.id].data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="wrap latest" aria-labelledby="latest-h">
    <h2 id="latest-h">Latest from the tackle box</h2>
    <PostList posts={latest} />
    <p class="all"><a href="/guides/">See all {posts.length} guides</a></p>
  </section>

  <section class="usa-band" aria-labelledby="usa-h">
    <div class="wrap usa-inner">
      <MadeBadge origin="usa" size={150} class="big-seal" />
      <div>
        <h2 id="usa-h">A stamp that means something</h2>
        <p>
          When the maker or the product listing says it's made in the USA, it gets our Made in USA stamp. If it's put
          together here from imported parts, it gets Assembled in USA. If nobody says, it gets no stamp. We don't
          guess.
        </p>
        <a href="/american-made-fishing-gear-guide/">Read the American-made gear guide</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-deep);
    color: #fff;
  }

  .hero-inner {
    position: relative;
    padding-top: clamp(3.5rem, 10vw, 7rem);
    padding-bottom: clamp(3.5rem, 9vw, 6.5rem);
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(3rem, 9vw, 6.2rem);
    line-height: 0.95;
    max-width: 13ch;
  }

  .sub {
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    max-width: 46ch;
    color: #dbe4ec;
    margin: 1.4rem 0 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .types {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .types h2 {
    margin-bottom: 1.2rem;
  }

  .first-trip {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .all {
    margin-top: 1.2rem;
    font-weight: 700;
  }

  .first-trip h2 {
    max-width: 24ch;
    margin-bottom: 1.6rem;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding-top: 3.6rem;
    border-top: 2px solid var(--navy);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    top: 0.6rem;
    left: 0;
    font-family: var(--display);
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--red);
  }

  .step-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1.05;
    color: var(--navy);
    margin: 0 0 0.4rem;
  }

  .step-line {
    color: var(--muted);
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }

  .steps a {
    font-weight: 600;
    font-size: 1rem;
  }

  .latest {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  .latest > :global(*) {
    max-width: 50rem;
  }

  .latest h2 {
    margin-bottom: 1rem;
  }

  .usa-band {
    margin-top: clamp(3.5rem, 8vw, 5rem);
    background: var(--brass-tint);
    border-top: 2px solid var(--brass);
    border-bottom: 2px solid var(--brass);
  }

  .usa-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-top: 2.8rem;
    padding-bottom: 2.8rem;
  }

  .usa-inner h2 {
    margin-bottom: 0.8rem;
  }

  .usa-inner p {
    max-width: 60ch;
  }

  .usa-inner a {
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .usa-inner {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
    .usa-inner :global(.big-seal svg) {
      width: 110px;
      height: 110px;
    }
  }
</style>
