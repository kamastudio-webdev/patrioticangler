---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title="All guides" description="Every Patriotic Angler how-to and gear guide, A to Z.">
  <div class="wrap page">
    <h1>All guides</h1>
    <p class="lede">Every how-to and gear guide on the site, A to Z. {posts.length} so far.</p>
    <PostList posts={posts} />
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2rem, 6vw, 3.5rem);
    max-width: calc(46rem + 2 * var(--gutter));
  }

  .lede {
    font-size: 1.25rem;
    margin: 1rem 0 2rem;
  }
</style>
